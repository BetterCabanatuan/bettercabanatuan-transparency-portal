{
  "name": "transparency-portal",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "A forkable FY2027 budget transparency portal for one LGU or DPWH district engineering office, built on the BetterGov.ph Budget API.",
  "scripts": {
    "dev": "vite",
    "setup": "tsx scripts/setup.ts",
    "check": "tsx scripts/check.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "deploy:cloudflare": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "wrangler": "^4.92.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
